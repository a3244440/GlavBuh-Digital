{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run check && npm test",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "includeFiles": "{src,public,cabinet/src,cabinet/public}/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
